# ========================================
# 1. Chat LLM Configuration
# ========================================
CHAT_API_KEY=your_api_key
CHAT_API_BASE=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat
CHAT_THINKING_MODEL=deepseek-reasoner  # Optional: for complex reasoning

# ========================================
# 2. Embedding Configuration
# ========================================
EMBEDDING_API_KEY=your_api_key
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ========================================
# 3. Rerank Configuration
# ========================================
RERANK_ENABLED=true
RERANK_API_KEY=your_api_key
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ========================================
# 4. RAG Retrieval Parameters
# ========================================
RETRIEVAL_TOP_K=100
RERANK_TOP_N=20
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5
MAX_TOTAL_CHARS=100000

# ========================================
# 5. System Configuration
# ========================================
CHROMA_PERSIST_DIR=./chroma_db
HOST=0.0.0.0
PORT=8000
